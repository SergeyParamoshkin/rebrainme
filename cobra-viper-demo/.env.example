# Пример файла с переменными окружения
# Скопируйте в .env и настройте под свои нужды

# Переменные окружения имеют приоритет над config.yaml
# Префикс DEMO_ добавляется автоматически

# Настройки сервера
DEMO_SERVER_HOST=0.0.0.0
DEMO_SERVER_PORT=8080

# Настройки базы данных
DEMO_DATABASE_HOST=localhost
DEMO_DATABASE_PORT=5432
DEMO_DATABASE_NAME=production_db
DEMO_DATABASE_USER=prod_user
DEMO_DATABASE_PASSWORD=secure_password

# Настройки логирования
DEMO_LOGGING_LEVEL=debug

# Настройки приложения
DEMO_APP_ENVIRONMENT=production
DEMO_APP_DEBUG=false

# Включить подробный вывод
DEMO_VERBOSE=true