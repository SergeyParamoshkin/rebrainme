# Переменные окружения для локальной разработки

# База данных (соответствует docker-compose.yml)
DEMO_DATABASE_HOST=localhost
DEMO_DATABASE_PORT=5432
DEMO_DATABASE_NAME=demo_db
DEMO_DATABASE_USER=demo_user
DEMO_DATABASE_PASSWORD=demo_password

# Сервер
DEMO_SERVER_HOST=localhost
DEMO_SERVER_PORT=8080

# Redis (если используется)
DEMO_REDIS_HOST=localhost
DEMO_REDIS_PORT=6379

# Логирование
DEMO_LOGGING_LEVEL=info

# Режим приложения
DEMO_APP_ENVIRONMENT=development
DEMO_APP_DEBUG=false

# Verbose output
DEMO_VERBOSE=false