[Unit]
Description=My Application
After=network.target

[Service]
Type=notify                   # Для поддержки sd_notify (опционально)
User=app-user
WorkingDirectory=/opt/my-app
ExecStart=/opt/my-app/my-app  # Основная команда запуска

# Readiness Probe (проверка перед запуском)
ExecStartPre=/bin/bash -c 'curl -sf http://localhost:8000/ready || exit 1'

# Liveness Probe (опционально, через внешний скрипт)
ExecReload=/bin/bash -c 'curl -sf http://localhost:8000/healthz || kill -SIGTERM $MAINPID'

# Настройки перезапуска
Restart=on-failure
RestartSec=5s
WatchdogSec=30s               # Таймаут для liveness
EnvironmentFile=/etc/default/my-app

[Install]
WantedBy=multi-user.target